# -----------------------------------------------------------------------------
# Smart Parking Backend - Environment Configuration Template
# Duplicate this file to '.env' and fill in the values below.
# -----------------------------------------------------------------------------

# Application Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String
# Local example: mongodb://localhost:27017/smart_parking
# Atlas example: mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_parking
MONGODB_URI=mongodb://localhost:27017/smart_parking

# Firebase Admin SDK Credentials
# Note: Set FIREBASE_PROJECT_ID=your-firebase-project-id to run in offline Mock Mode
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...\n-----END PRIVATE KEY-----\n"
